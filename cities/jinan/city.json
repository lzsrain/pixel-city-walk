  "zones": {
    "qianfo": {
      "name": "千佛山",
      "icon": "⛰️",
      "x": 230,
      "y": 205,
      "desc": "从山门沿石阶向上走",
      "scenes": [
        {
          "name": "山门石阶",
          "x": 250,
          "y": 185,
          "text": "山门一过，石阶把城市的车流声隔在身后。树影从两侧压下来，脚步不自觉放慢，这是千佛山给你的第一个提示：上山不需要赶路。",
          "a": "玩法",
          "at": "沿石阶向上，半山有平台可歇",
          "b": "气氛",
          "bt": "山林掩古建，清晨人最少"
        },
        {
          "name": "山腰泉潭",
          "x": 355,
          "y": 365,
          "text": "水从山石之间跌落下来，在半山聚成一小潭。泉城的水脉从这里有了想象——山上有泉，泉连着湖，湖连着城。坐在潭边听一会，水声盖过远处的路。",
          "a": "声音",
          "at": "跌水声清晰，雨后更响",
          "b": "建议",
          "bt": "潭边石凳坐五分钟再走"
        }
      ]
    },
    "baotu": {
      "name": "趵突泉",
      "icon": "💧",
      "x": 300,
      "y": 510,
      "desc": "沿泉水寻找不断翻涌的泉眼",
      "scenes": [
        {
          "name": "三股泉眼",
          "x": 330,
          "y": 500,
          "text": "三股泉水从池底同时翻涌，水柱有节奏地起落，从不间断。这是“泉城”得名的地方，也是济南所有泉眼里最直白的一处——水就在你脚边，伸手能碰到。",
          "a": "看点",
          "at": "三股泉眼昼夜不停翻涌",
          "b": "体验",
          "bt": "贴栏俯身听水声，别用闪光灯"
        },
        {
          "name": "泉边亭台",
          "x": 245,
          "y": 570,
          "text": "亭台压在水边，柳枝从头顶垂下来，水面把金瓦和绿色一起揉碎。这里适合停下来看细节：水纹、鱼、倒影，每一秒都不一样。绕水岸走半圈，会发现亭子换了角度。",
          "a": "路线",
          "at": "沿北岸向东绕行回望亭台",
          "b": "颜色",
          "bt": "碧水、金瓦、垂柳三色相叠"
        }
      ]
    },
    "square": {
      "name": "泉城广场",
      "icon": "⛲",
      "x": 760,
      "y": 575,
      "desc": "从城市中心向四个方向散步",
      "scenes": [
        {
          "name": "泉标广场",
          "x": 760,
          "y": 560,
          "text": "这里是济南的城市客厅，也是像素世界的中心点。蓝色泉标立在广场正中，向东能走到老城，向北通往大明湖，向西一拐就是趵突泉。不管从哪个方向回来，这里都像是一个坐标原点。",
          "a": "作用",
          "at": "旅行主城，四面出发的起点",
          "b": "方向",
          "bt": "西去看泉、北去看湖、东进老城"
        },
        {
          "name": "城市水轴",
          "x": 820,
          "y": 620,
          "text": "广场南侧有一排水景把道路和广场串在一起，走动时比看地图更能感到这座城市的尺度。水轴不长，但它是从广场过渡到护城河的一条线，顺着走能接上黑虎泉。",
          "a": "体验",
          "at": "沿水景向南步行接护城河",
          "b": "夜间",
          "bt": "泉标和水景有灯光，傍晚后更热闹"
        }
      ]
    },
    "daming": {
      "name": "大明湖",
      "icon": "🪷",
      "x": 1126,
      "y": 234,
      "desc": "绕湖岸寻找荷花、游船与石桥",
      "scenes": [
        {
          "name": "荷花湖面",
          "x": 1090,
          "y": 250,
          "text": "风一过，荷叶翻出背面，颜色变浅又变深。湖面上有游船慢慢移动，船尾拖出一道细纹。大明湖不是一块静止的蓝色，它一直在被风、船和阳光改写。夏天荷花最密，沿北岸走能看见大片莲叶。",
          "a": "季节",
          "at": "7-8月荷花盛开，最具代表性",
          "b": "散步",
          "bt": "沿北岸向西，湖面最开阔"
        },
        {
          "name": "湖心亭",
          "x": 1035,
          "y": 310,
          "text": "石桥把湖岸和亭子连在一起，柳树从两侧压向水面。这是大明湖最安静的一面：坐在亭里看湖，能听见自己呼吸。清晨水雾未散时最好，人少、光柔、水像一块磨过的玻璃。",
          "a": "气氛",
          "at": "慢时间的城市角落，适合发呆",
          "b": "建议",
          "bt": "清晨或傍晚停留，避开正午暴晒"
        }
      ]
    },
    "oldcity": {
      "name": "曲水亭街",
      "icon": "🏮",
      "x": 920,
      "y": 440,
      "desc": "沿泉水穿过老街、院落和小桥",
      "scenes": [
        {
          "name": "泉水老街",
          "x": 900,
          "y": 420,
          "text": "泉水从街边明渠里流过，石板路被水磨得发亮。旧房子紧挨着渠，居民出门就能看见水。这不是景区里搬来的水景，是真实的老城生活——洗衣、浇花、聊天，都围着这条水。",
          "a": "特点",
          "at": "泉水直接流进日常街巷",
          "b": "适合",
          "bt": "边走边看生活细节，别赶路"
        },
        {
          "name": "老城小桥",
          "x": 965,
          "y": 395,
          "text": "几座小石桥跨在泉渠上，桥面被踩得圆润。桥不是给游客拍照用的，是街巷两边居民每天的通道。站在桥上看水流从脚下过，能明白曲水亭街“曲”在哪里——水弯，街就跟着弯。",
          "a": "路线",
          "at": "从大明湖南侧走进老城",
          "b": "气氛",
          "bt": "安静、生活化，午后光影好"
        }
      ]
    },
    "heihu": {
      "name": "黑虎泉·护城河",
      "icon": "🐯",
      "x": 1162,
      "y": 620,
      "desc": "从黑虎泉沿护城河一路向南走",
      "scenes": [
        {
          "name": "黑虎泉",
          "x": 1123,
          "y": 598,
          "text": "泉水从石雕虎头口中奔涌而出，落进下方泉池，声音沉闷有力。和趵突泉的“翻涌”不同，黑虎泉是“冲出来”的，水势更猛。池水清到能看见底，护栏边常年有本地人提桶打水。",
          "a": "看点",
          "at": "三尊虎头出水，昼夜不息",
          "b": "声音",
          "bt": "近处能感到水流的冲击声"
        },
        {
          "name": "护城河水路",
          "x": 1139,
          "y": 726,
          "text": "从黑虎泉向南，护城河变成一条连续的水路。河两岸有柳树和步道，水把泉群、老城和城市绿道串在一起。沿河走不需要看地图，跟着水走就能走到下一处。河里有游船经过，但岸上更自在。",
          "a": "路线",
          "at": "沿河东岸向南步行",
          "b": "体验",
          "bt": "水、树荫与城市并行，夏天最凉快"
        },
        {
          "name": "河畔慢行道",
          "x": 1162,
          "y": 865,
          "text": "走到这里，护城河已经从景区变成了城市生活的一部分。跑步的人、遛弯的老人、骑车的孩子共享这条沿河绿道。游览不再是一个个景点，而是一条连续的泉水生活线——水一直流，路一直沿。",
          "a": "适合",
          "at": "慢走、骑行、跑步都合适",
          "b": "方向",
          "bt": "继续向南可接环城公园全线"
        }
      ]
    }
  }
