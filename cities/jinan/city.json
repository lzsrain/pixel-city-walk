  "npc": {
    "name": "泉宝",
    "role": "你的泉城向导",
    "spriteFilter": "hue-rotate(85deg) saturate(1.35)",
    "welcome": {
      "kicker": "欢迎来到泉城",
      "title": "你好，我是泉宝。\n先告诉我你叫什么？",
      "text": "我会陪你走进这张济南像素地图，发现泉水、老街和湖边的故事。",
      "inputPlaceholder": "输入你的名字",
      "submitLabel": "认识一下"
    },
    "guide": [
      {
        "title": "你好，{name}！",
        "text": "我是泉宝，从现在开始由我带你逛泉城。这里没有固定路线，你想先去哪儿都可以。"
      },
      {
        "title": "先从整张地图选一站",
        "text": "地图上的黄色地标都能点击。选中千佛山、趵突泉、大明湖或老城，就会进入那一片区域。"
      },
      {
        "title": "让小人真正走起来",
        "text": "进入景点后，用 WASD 或方向键行走；不习惯键盘，也可以直接点击地面，小人会自己走过去。"
      },
      {
        "title": "靠近闪光，听听故事",
        "text": "看到闪光标记就走近它，按 E 或点击“看看”。喜欢的风景可以收进你的旅行手账。"
      }
    ],
    "guideNextLabel": "继续",
    "guideStartLabel": "去选择第一站"
  },
